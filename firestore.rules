rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // -------------------------
    // Basic auth helpers
    // -------------------------
    // Meaning: reject every request from users who are not logged in.
    function isSignedIn() {
      return request.auth != null;
    }

    // Meaning: true when the target user document belongs to the logged-in user.
    function isSelf(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Meaning: safely read the caller's own users/{uid} document.
    function requesterUser() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Meaning: teacher can read all users documents.
    function isTeacher() {
      return isSignedIn() && requesterUser().role == 'teacher' && requesterUser().status == 'active';
    }

    // -------------------------
    // users collection (Step 5-4 initial rules)
    // -------------------------
    match /users/{userId} {
      // Meaning: validation used when users/{uid} is created for the first time.
      function validUserCreate() {
        return request.resource.data.uid == request.auth.uid &&
               request.resource.data.uid == userId &&
               request.resource.data.email is string &&
               request.resource.data.email == lower(request.resource.data.email) &&
               request.resource.data.role in ['teacher', 'student'] &&
               request.resource.data.status == 'active' &&
               request.resource.data.createdAt is timestamp &&
               request.resource.data.updatedAt is timestamp &&
               request.resource.data.lastLoginAt is timestamp;
      }

      // Meaning: users can update only safe profile/login fields for themselves.
      // role/status/createdAt cannot be changed by client-side users.
      function validUserUpdate() {
        return request.resource.data.uid == resource.data.uid &&
               request.resource.data.uid == request.auth.uid &&
               request.resource.data.role == resource.data.role &&
               request.resource.data.status == resource.data.status &&
               request.resource.data.createdAt == resource.data.createdAt &&
               request.resource.data.email is string &&
               request.resource.data.email == lower(request.resource.data.email) &&
               request.resource.data.updatedAt is timestamp &&
               request.resource.data.lastLoginAt is timestamp;
      }

      // Not logged in -> denied by condition.
      // Logged in user can read own doc.
      // Teacher can read all users docs.
      allow get: if isSignedIn() && (isSelf(userId) || isTeacher());

      // list/query of users is teacher-only.
      allow list: if isSignedIn() && isTeacher();

      // First-time creation: self only with strict shape.
      allow create: if isSelf(userId) && validUserCreate();

      // Update: self only and no role/status tampering.
      allow update: if isSelf(userId) && validUserUpdate();

      // Delete is blocked for now (safer default for account records).
      allow delete: if false;
    }


    // -------------------------
    // students collection (Phase 5-1 initial rules)
    // -------------------------
    match /students/{studentId} {
      // Teacher can read all student docs.
      function canTeacherReadStudent() {
        return isTeacher();
      }

      // Student can read only own student document.
      // Supports matching by uid OR lowercase email.
      function canStudentReadOwnStudentDoc() {
        return isSignedIn() && (
          resource.data.uid == request.auth.uid ||
          resource.data.email == lower(request.auth.token.email)
        );
      }

      allow get: if canTeacherReadStudent() || canStudentReadOwnStudentDoc();
      allow list: if canTeacherReadStudent();

      // Create/update/delete are blocked in this phase.
      allow create, update, delete: if false;
    }


    // -------------------------
    // Core learning data collections (Phase 5)
    // -------------------------
    function isStudentOwner(data) {
      return isSignedIn() && data.ownerUid == request.auth.uid;
    }

    function canReadCoreData(data) {
      return isTeacher() || isStudentOwner(data);
    }

    function hasRequiredCoreCreateFields(data) {
      return data.keys().hasAll([
        'ownerUid',
        'ownerEmail',
        'studentId',
        'teacherUid',
        'createdAt',
        'updatedAt'
      ]) &&
      data.ownerUid is string &&
      data.ownerEmail is string &&
      data.studentId is string &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    function validCoreCreate(data) {
      return hasRequiredCoreCreateFields(data) &&
             (isTeacher() || (
               data.ownerUid == request.auth.uid &&
               data.ownerEmail == lower(request.auth.token.email)
             ));
    }

    function validCoreUpdate() {
      return request.resource.data.ownerUid == resource.data.ownerUid &&
             request.resource.data.ownerEmail == resource.data.ownerEmail &&
             request.resource.data.studentId == resource.data.studentId &&
             request.resource.data.teacherUid == resource.data.teacherUid &&
             request.resource.data.createdAt == resource.data.createdAt &&
             request.resource.data.updatedAt is timestamp &&
             canReadCoreData(resource.data);
    }

    match /essays/{essayId} {
      allow get, list: if canReadCoreData(resource.data);
      allow create: if isSignedIn() && validCoreCreate(request.resource.data);
      allow update: if isSignedIn() && validCoreUpdate();
      allow delete: if isSignedIn() && canReadCoreData(resource.data);
    }

    match /vocab/{vocabId} {
      allow get, list: if canReadCoreData(resource.data);
      allow create: if isSignedIn() && validCoreCreate(request.resource.data);
      allow update: if isSignedIn() && validCoreUpdate();
      allow delete: if isSignedIn() && canReadCoreData(resource.data);
    }

    match /articles/{articleId} {
      allow get, list: if canReadCoreData(resource.data);
      allow create: if isSignedIn() && validCoreCreate(request.resource.data);
      allow update: if isSignedIn() && validCoreUpdate();
      allow delete: if isSignedIn() && canReadCoreData(resource.data);
    }

    // -------------------------------------------------
    // Temporary placeholders for other collections
    // (will be replaced in later steps)
    // -------------------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
